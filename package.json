{
  "name": "@vanduo-oss/vdl-ai-chat",
  "version": "0.1.0",
  "description": "Vanduo Labs headless on-device AiChat (LiteRT Gemma / WebLLM) with FOSS guardrails",
  "type": "module",
  "homepage": "https://github.com/vanduo-oss/vdl-ai-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanduo-oss/vdl-ai-chat.git"
  },
  "bugs": {
    "url": "https://github.com/vanduo-oss/vdl-ai-chat/issues"
  },
  "license": "MIT",
  "author": "vanduo-oss",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vanduo",
    "ai-chat",
    "gemma",
    "litert",
    "webllm",
    "guardrails",
    "on-device"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./guardrails/llm": {
      "types": "./dist/guardrails/llm.d.ts",
      "import": "./dist/guardrails/llm.js",
      "require": "./dist/guardrails/llm.cjs"
    },
    "./guardrails/tools": {
      "types": "./dist/guardrails/tools.d.ts",
      "import": "./dist/guardrails/tools.js",
      "require": "./dist/guardrails/tools.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && vite build && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm run test:ci",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:e2e": "node scripts/ensure-gemma-e2e-model.mjs && pnpm run build && playwright test -c tests/e2e/playwright.config.ts",
    "test:local": "pnpm run test:ci && pnpm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@litert-lm/core": "^0.15.0",
    "@litertjs/wasm-utils": "2.5.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.1.0",
    "@typescript-eslint/parser": "8.62.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.62.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.2"
}
